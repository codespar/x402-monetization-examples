# A CodeSpar key. Use csk_live_... to sell for real on Base mainnet; this
# example's whole point is a full-price $85 settlement, not a sandbox toy.
# Use a csk_test_ key first if you want to rehearse on Base Sepolia.
CODESPAR_API_KEY=csk_live_...

# The CodeSpar-provisioned wallet that receives the $85 per report. Get one
# at https://codespar.dev
CODESPAR_CONSUMER_ID=your_consumer_id

# Where the report generator lives. Paid calls proxy here; add your own auth
# upstream if needed (stored server-side, never exposed to the buyer).
UPSTREAM_URL=https://api.yourservice.com/reports/company

# Optional. Defaults to https://api.codespar.dev
# CODESPAR_API_BASE=https://api.codespar.dev
