# --- seller.mjs ---

# A CodeSpar key. Get one at https://codespar.dev. Use a csk_test_ key on
# Base Sepolia before pointing this at anything real.
CODESPAR_API_KEY=csk_test_...

# The journalist's real article API, fronted by the paywall.
# ARTICLE_API_URL=https://api.yourpublication.com/articles/latest

# The provisioned consumer that receives the USDC from the paywall.
# CONSUMER_ID=your_consumer_id

# The journalist's real Pix key, where the tip link pays out.
# JOURNALIST_PIX_KEY=journalist@pix.br

# Slug for the paywall. Optional, defaults to journalist-article.
# PAYWALL_SLUG=journalist-article

# Optional. Defaults to https://api.codespar.dev
# CODESPAR_API_BASE=https://api.codespar.dev

# --- buyer.mjs ---

# A Base Sepolia wallet with a little test USDC, to pay the excerpt.
# The payer is gasless, so it needs USDC but not ETH. Fund it from
# https://faucet.circle.com
PRIVATE_KEY=0x...

# The paywall URL printed by seller.mjs.
# ARTICLE_GATEWAY_URL=https://gw.codespar.dev/journalist-article

# The tip link's slug, printed by seller.mjs (payment-link create doesn't
# take a slug, the API assigns one).
# TIP_LINK_SLUG=...

# A signed mandate carrying a BRL:pix slot, and its signature. Produced by
# `codespar mandate create ...` (see ../../cli/README.md), not by this
# script. Both are optional; without them buyer.mjs pays the USDC excerpt
# only and skips the Pix tip.
# MANDATE={"...":"..."}
# MANDATE_SIGNATURE=0x...
