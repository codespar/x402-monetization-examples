# A CodeSpar key. csk_test_... rehearses on Base Sepolia; csk_live_... sells
# for real on Base mainnet.
CODESPAR_API_KEY=csk_test_...

# The CodeSpar-provisioned wallet that receives the $0.50 per call. Get one
# at https://codespar.dev
CODESPAR_CONSUMER_ID=your_consumer_id

# Where the digest generator lives. Paid calls proxy here; add your own auth
# upstream if needed (stored server-side, never exposed to the buyer).
UPSTREAM_URL=https://api.yourservice.com/digest

# Optional. Defaults to https://api.codespar.dev
# CODESPAR_API_BASE=https://api.codespar.dev
