# A CodeSpar key. Use csk_test_... first (Base Sepolia); get one at
# https://codespar.dev
CODESPAR_API_KEY=csk_test_...

# The provisioned wallet all three resources pay into (the sellers' receiving
# wallet; separate from "shopper", the buyer's mandate consumer below).
CONSUMER_ID=your_consumer_id

# Optional. Defaults to https://api.codespar.dev
# CODESPAR_API_BASE=https://api.codespar.dev

# Optional. Real upstreams for the paywall and the MCP server. Defaults are
# placeholders, same as api-paywall's and mcp-server's own examples; point
# these at your own API and MCP server to actually serve traffic.
# UPSTREAM_API_URL=https://api.yourservice.com/quotes
# UPSTREAM_MCP_URL=https://mcp.yourservice.com

# Optional, buyer side (buyer.mjs). Defaults to "shopper" / "buyer", matching
# ../../cli/README.md.
# CODESPAR_CONSUMER=shopper
# CODESPAR_AGENT=buyer
