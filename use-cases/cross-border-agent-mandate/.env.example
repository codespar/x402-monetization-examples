# A CodeSpar key, test or live. Get one at https://codespar.dev
CODESPAR_API_KEY=csk_test_...

# The provisioned wallet that receives the USDC leg's 0.03 USDC per translate call.
CODESPAR_CONSUMER_ID=your_consumer_id

# The MCP server that actually implements the "translate" tool. There is no
# public stand-in wired up here; point this at your own upstream, same as
# mcp-server's own examples use https://mcp.yourservice.com.
UPSTREAM_MCP_URL=https://mcp.yourservice.com

# Optional. The Pix key the payment link pays out to.
# SELLER_PIX_KEY=seller@pix.br

# Optional. Defaults to https://api.codespar.dev
# CODESPAR_API_BASE=https://api.codespar.dev
